  "fixed_sql": [
    {
      "name": "local_owners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_owners\" (\"id\" TEXT NOT NULL, \"next_dex_number\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cats\" (\"id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL REFERENCES local_owners (id), \"dex_number\" INTEGER NOT NULL, \"name\" TEXT NULL, \"coat_color\" TEXT NULL, \"pattern\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), PRIMARY KEY (\"id\"), UNIQUE (\"owner_id\", \"dex_number\"));"
        }
      ]
    },
    {
      "name": "sightings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sightings\" (\"id\" TEXT NOT NULL, \"cat_id\" TEXT NOT NULL REFERENCES cats (id), \"seen_at\" INTEGER NOT NULL, \"lat\" REAL NULL, \"lng\" REAL NULL, \"place_name\" TEXT NULL, \"country_code\" TEXT NULL, \"note\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK ((lat IS NULL AND lng IS NULL) OR (lat IS NOT NULL AND lng IS NOT NULL AND lat BETWEEN -90 AND 90 AND lng BETWEEN -180 AND 180)));"
        }
      ]
    },
    {
      "name": "photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photos\" (\"id\" TEXT NOT NULL, \"sighting_id\" TEXT NOT NULL REFERENCES sightings (id), \"local_path\" TEXT NOT NULL, \"storage_key\" TEXT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"blurhash\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
